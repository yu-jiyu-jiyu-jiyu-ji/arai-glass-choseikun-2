# mock（既定）のまま開発可能。本番接続時は false
CHOSEIKUN_USE_MOCK=true

# --- 既存 nittei_chosei_system と同じものを流用可 ---
# Firebase / Firestore
# GOOGLE_APPLICATION_CREDENTIALS=../nittei_chosei_system/path-to-service-account.json

# Google Calendar OAuth（職人カレンダー連携）
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# Google Maps（Distance Matrix / Geocoding）※Calendarとは別キーのことが多い
# GOOGLE_MAPS_API_KEY=
