# カレンダー予定・移動時間のモック（当面 true/false どちらでも台帳は別設定可）
CHOSEIKUN_USE_MOCK=true

# 台帳: json（ローカル） / firestore（会社の Firebase）
# CHOSEIKUN_DATA_BACKEND=firestore

# --- 既存 nittei_chosei_system と同じものを流用 ---
# Firebase / Firestore
# ローカル: JSON ファイルのパス
# GOOGLE_APPLICATION_CREDENTIALS=../nittei_chosei_system/schedule-adjustment-….json
# Render 等: JSON ファイルの中身を1行（またはそのまま）貼る
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Calendar OAuth（職人カレンダー連携・次フェーズ）
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/calendar/callback

# Google Maps（Distance Matrix / Geocoding・次フェーズ）
# GOOGLE_MAPS_API_KEY=
